# ══════════════════════════════════════════════════════════════════════════════
# ProFit Studio — variables de entorno (SOLO valores de ejemplo, nunca reales)
#
# Local:      copia este archivo a ".env" y cambia lo que necesites. ".env" no se sube a git.
# Producción: las variables se definen en Railway > tu servicio > Variables (no hay archivo .env).
#
# Para revisar que todo quedó bien configurado (no muestra secretos):
#     python manage.py check_infra            (agrega --smtp para probar el correo sin enviar nada)
#
# Leyenda:  OBLIGATORIA = el servidor no arranca o no funciona sin ella en producción.
#           OPCIONAL    = la web funciona sin ella; se indica qué se pierde.
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════ DJANGO ═══════════════════════════════════════
# Qué archivo de configuración usar. Railway ya lo fija (railway.toml / start.sh); en local
# se usa config.settings.development para que funcione con SQLite y correo en consola.
# OPCIONAL (en producción el valor por defecto de start.sh ya es config.settings.production).
# DJANGO_SETTINGS_MODULE=config.settings.production

# Clave secreta de Django (firma sesiones y enlaces). OBLIGATORIA en producción: el servidor no
# arranca si falta o si es este valor de ejemplo. Se genera tú misma, no se pide a nadie:
#     python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=cambia-esta-clave-secreta-en-produccion

# Modo depuración. Solo True en tu computador. En producción se fuerza a False, pero no la dejes en True.
# OPCIONAL (por defecto False).
DEBUG=True

# Dominios desde los que se acepta la web, separados por coma y SIN "*". OBLIGATORIA en producción.
# Se obtienen de Railway > Settings > Networking (dominio ...up.railway.app) y de tu dominio propio.
# Ej. de producción: profit-studio.up.railway.app,www.tudominio.com
ALLOWED_HOSTS=localhost,127.0.0.1


# ══════════════════════════════ RAILWAY ══════════════════════════════════════
# Conexión a PostgreSQL. OBLIGATORIA en producción (sin ella usa SQLite y los datos se pierden en
# cada redeploy). Railway la crea sola al agregar el servicio PostgreSQL: en tu servicio web usa
# Variables > Add Reference > DATABASE_URL. En local no la necesitas (development.py usa SQLite).
DATABASE_URL=postgresql://usuario:password@host:5432/profitstudio

# Puerto en el que escucha el servidor. Lo inyecta Railway solo: NO lo definas tú en producción.
# OPCIONAL (start.sh usa 8000 si no existe).
# PORT=8000

# Redis como caché y almacén de sesiones. OPCIONAL: sin ella se usa memoria local del servidor
# (la web funciona igual). Se obtiene agregando un servicio Redis en Railway y referenciando REDIS_URL.
REDIS_URL=redis://localhost:6379/0

# Contraseña inicial de la superusuaria 'yiseth'. OPCIONAL pero necesaria la primera vez: start.sh
# crea la cuenta solo si esta variable existe (si la cuenta ya existe, no cambia su contraseña).
# Déjala vacía en el repo; defínela solo en Railway > Variables y bórrala después si quieres.
TRAINER_INITIAL_PASSWORD=


# ═════════════════════════ CLOUDFLARE R2 (archivos) ═══════════════════════════
# Almacenamiento de fotos, imágenes/videos de ejercicios y comprobantes de pago.
# Panel: dash.cloudflare.com > R2 Object Storage. OPCIONAL en conjunto: sin R2 los archivos se guardan
# en disco y SE PIERDEN en cada redeploy de Railway. Si usas R2, las 4 primeras son OBLIGATORIAS
# y R2_RECEIPTS_BUCKET_NAME es obligatoria en la práctica (ver más abajo).

# Credenciales del token de API. Se crean en R2 > Manage API Tokens > Create API Token (permiso
# "Object Read & Write" sobre los buckets); Cloudflare muestra los dos valores una sola vez.
R2_ACCESS_KEY_ID=tu-r2-access-key-id
R2_SECRET_ACCESS_KEY=tu-r2-secret-access-key

# Bucket de media PÚBLICA (imágenes/videos de ejercicios, fotos de perfil). Lo creas en R2 > Create bucket.
R2_BUCKET_NAME=profitstudio-media

# Endpoint de la API S3 (lo usa boto3 para subir/leer). TU_ACCOUNT_ID = ID de cuenta de Cloudflare
# (R2 > Overview, o la URL "S3 API" que aparece al crear el token).
# Requiere credenciales: NO es una URL pública.
R2_ENDPOINT_URL=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com

# URL pública del bucket de media (R2 > tu bucket > Settings > Public access > r2.dev, o dominio personalizado).
# Solo el origen: https y SIN ruta ni nombre de bucket. El código toma el host como
# AWS_S3_CUSTOM_DOMAIN; si falta, las URLs de media apuntan a la API y no se ven en el navegador.
# OPCIONAL pero sin ella las imágenes y videos no se ven en la web.
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# Bucket PRIVADO solo para comprobantes de pago (sin r2.dev ni dominio personalizado). Obligatorio
# en la práctica: en R2 el acceso público es por bucket, no por carpeta. Sus URLs siempre salen
# firmadas contra el endpoint de la API, nunca por R2_PUBLIC_URL. Debe ser DISTINTO de R2_BUCKET_NAME.
R2_RECEIPTS_BUCKET_NAME=profitstudio-receipts


# ═══════════════════════ WOMPI (pagos online, Colombia) ═══════════════════════
# OPCIONAL: sin estas 4 claves los pagos online NO funcionan (los pagos manuales de efectivo/
# transferencia sí). Se obtienen en el panel de comercios de Wompi (comercios.wompi.co), en la
# sección de desarrolladores/llaves. Usa las claves de PRUEBA mientras pruebas y las de
# PRODUCCIÓN solo al salir en vivo. Las 4 deben ser del mismo ambiente.
# WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
# WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxx
# WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxx
# WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxx


# ═════════════════════ CORREO (recuperar contraseña) ══════════════════════════
# OPCIONAL: sin EMAIL_HOST_USER los correos NO se envían (salen por la consola/log).
# Con Gmail: activa la verificación en dos pasos y crea una "contraseña de aplicación"
# (Cuenta de Google > Seguridad > Contraseñas de aplicaciones). NO uses la contraseña normal de la cuenta.
# Para probar el inicio de sesión sin enviar nada: python manage.py check_infra --smtp
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=tu-contrasena-de-aplicacion-de-gmail
# Servidor y puerto SMTP. OPCIONALES (por defecto smtp.gmail.com y 587 con TLS).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# Remitente que ven las clientas. OPCIONAL (por defecto "ProFit Studio <EMAIL_HOST_USER>").
# DEFAULT_FROM_EMAIL=ProFit Studio <tu-correo@gmail.com>


# ═══════════════════════ CONTACTO PROFIT STUDIO ═══════════════════════════════
# Datos públicos que se muestran en la web (botón de WhatsApp, redes). No son secretos.
# OPCIONALES: si no los defines se usan estos mismos valores por defecto.
WHATSAPP_NUMBER=+573005638196
WHATSAPP_LINK=https://wa.me/573005638196
INSTAGRAM_URL=https://instagram.com/profitstudio75


# ═══════════ SALUD DE LA CLIENTA (medidas, consentimiento, ficha) ═════════════
# Interruptor de las pantallas de salud. OPCIONAL: apagado por defecto en producción (las pantallas
# responden 404) hasta que un abogado apruebe los textos de consentimiento y la superusuaria publique la
# versión definitiva en Admin > Textos de consentimiento. En desarrollo (development.py) está encendido.
HEALTH_FEATURES_ENABLED=false
# Dirección pública (https) de la política de tratamiento de datos personales; se muestra junto al
# consentimiento. OPCIONAL (vacío = no se muestra el enlace), pero hay que definirla antes de encender las
# pantallas de salud. La publica el negocio (por ejemplo en su web) con el texto que apruebe su abogado.
PRIVACY_POLICY_URL=
