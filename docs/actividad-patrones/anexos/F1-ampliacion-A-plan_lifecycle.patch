+def expire_overdue_plans(today=None):
+    """`approved` -> `expired` para los planes cuya `valid_until` es anterior a `today`. Devuelve cuántos.
+
+    `today` es hoy (`dates.today()`) si no se indica. Desactiva la rutina de cada plan y registra su
+    evento sin actor (lo hace el sistema, no una persona). Es idempotente: solo toca planes que
+    siguen en `approved`, así que repetirlo no cambia nada.
+    """
+    if today is None:
+        today = dates.today()
+    with transaction.atomic():
+        overdue = _lock_overdue_approved(today)
+        for plan in overdue:
+            plan.status = STATUS_EXPIRED
+            plan.save(update_fields=['status'])
+            _set_routine_active(plan, False)
+            _record_event(plan, None, ACTION_EXPIRED, EXPIRED_NOTE)
+            logger.info('Plan %s: approved -> expired (vigencia hasta %s).', plan.pk, plan.valid_until)
+    return len(overdue)
